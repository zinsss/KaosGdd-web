# Core app
APP_NAME=KaosGdd Web
APP_TIMEZONE=Asia/Seoul
APP_HEALTH_MODE=frozen-v0-raw-edit

# Database
DATABASE_URL=sqlite:////data/kaosgdd.db
# Used by PostgreSQL deployments. SQLite ignores it.
DATABASE_SCHEMA=main

# Web/app URL
APP_BASE_URL=
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_APP_TIMEZONE=Asia/Seoul

# Korean public holiday iCal subscription feed.
# Defaults to Google Korea Holidays; set blank to disable or replace with another iCal feed.
KOREAN_HOLIDAY_ICAL_URL=https://calendar.google.com/calendar/ical/ko.south_korea%23holiday%40group.v.calendar.google.com/public/basic.ics

# File storage
FILE_STORAGE_DIR=/data/uploads

# Reminder defaults
DEFAULT_SNOOZE_MINUTES=10
REMINDER_MISSED_SCAN_LOOKBACK_HOURS=2

# Lifecycle retention
LIFECYCLE_DONE_RETENTION_DAYS=365
LIFECYCLE_REMOVED_RETENTION_DAYS=90
LIFECYCLE_FIRED_RETENTION_DAYS=30


# Daily summary notifications
# Systemd timers currently control actual schedule.
# These values document/configure app-level summary slots and future runtime settings.
# Keep server local timezone aligned with APP_TIMEZONE for systemd timers.
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_MORNING_TIME=08:30
DAILY_SUMMARY_LUNCH_TIME=13:05
DAILY_SUMMARY_BEFORE_OFF_TIME=17:15
DAILY_SUMMARY_BEFORE_SLEEP_TIME=22:00
DAILY_SUMMARY_BODY_MAX_LINES=3
DAILY_SUMMARY_FLAGS_FIRST=true

# Notifications
# Pushover Emergency requires PUSHOVER_ENABLED=true and PUSHOVER_EMERGENCY_ENABLED=true.
# PUSHOVER_ENABLED is the master Pushover switch.
PUSHOVER_ENABLED=false
PUSHOVER_PRIORITY_DEFAULT=0
PUSHOVER_DEVICE=
PUSHOVER_EMERGENCY_ENABLED=false
PUSHOVER_EMERGENCY_RETRY_SECONDS=60
PUSHOVER_EMERGENCY_EXPIRE_SECONDS=1800

# Pushover secrets
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
